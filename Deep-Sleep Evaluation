#include <WiFi.h>
#include "DHTesp.h"

// Pin
const int DHT_PIN = 15;
const int LED_NORMAL = 2;
const int LED_ALARM = 4;
const int BUZZER_PIN = 5;

// Ambang batas
const float AMBANG_SUHU_KRITIS = 38.0;
const float AMBANG_LEMBAB_RENDAH = 20.0;

// Pengaturan Deep Sleep
const uint64_t INTERVAL_TIDUR_DETIK = 10 * 60;   // 10 menit
#define uS_TO_S 1000000ULL

const char* ssid = "Wokwi-GUEST";
const char* password = "";

DHTesp dhtSensor;
RTC_DATA_ATTR int bootCount = 0;   // tetap tersimpan selama deep sleep

void setup() {
  Serial.begin(115200);
  bootCount++;
  Serial.printf("\n=== Bangun ke-%d ===\n", bootCount);

  pinMode(LED_NORMAL, OUTPUT);
  pinMode(LED_ALARM, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  // 1. Baca sensor
  dhtSensor.setup(DHT_PIN, DHTesp::DHT22);
  TempAndHumidity data = dhtSensor.getTempAndHumidity();

  if (isnan(data.temperature) || isnan(data.humidity)) {
    Serial.println("[Error] Gagal membaca DHT22!");
  } else {
    Serial.printf("Suhu: %.2f C | Kelembaban: %.2f %%\n",
                  data.temperature, data.humidity);

    // 2. Cek alarm (multi-condition)
    bool suhuKritis   = data.temperature > AMBANG_SUHU_KRITIS;
    bool lembabRendah = data.humidity < AMBANG_LEMBAB_RENDAH;

    if (suhuKritis || lembabRendah) {
      digitalWrite(LED_ALARM, HIGH);
      tone(BUZZER_PIN, 1000);
      if (suhuKritis && lembabRendah)
        Serial.println(">>> ALARM [SUHU & KELEMBABAN] <<<");
      else if (suhuKritis)
        Serial.println(">>> ALARM [SUHU TINGGI] <<<");
      else
        Serial.println(">>> ALARM [UDARA KERING] <<<");
      delay(3000);          // alarm menyala 3 detik sebelum tidur
      noTone(BUZZER_PIN);
      digitalWrite(LED_ALARM, LOW);
    } else {
      digitalWrite(LED_NORMAL, HIGH);
      Serial.println("Status: Normal");
      delay(1000);
      digitalWrite(LED_NORMAL, LOW);
    }

    // 3. Kirim data lewat Wi-Fi (dengan batas waktu)
    WiFi.begin(ssid, password);
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
      delay(250);
      attempts++;
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("Wi-Fi terhubung, data dikirim (simulasi).");
      // di sini tempat kode kirim data (HTTP/MQTT) kalau ada
    } else {
      Serial.println("Wi-Fi gagal, data tidak terkirim.");
    }
    WiFi.disconnect(true);   // matikan radio sebelum tidur
    WiFi.mode(WIFI_OFF);
  }

  // 4. Masuk Deep Sleep
  Serial.printf("Tidur %llu detik...\n", INTERVAL_TIDUR_DETIK);
  Serial.flush();
  esp_sleep_enable_timer_wakeup(INTERVAL_TIDUR_DETIK * uS_TO_S);
  esp_deep_sleep_start();
}

void loop() {
  // Kosong: tidak pernah dijalankan karena ESP32 tidur di akhir setup()
}
