#include <WiFi.h>
#include "DHTesp.h"

// Definisi Pin Periferal
const int DHT_PIN = 15;
const int LED_NORMAL = 2;
const int LED_ALARM = 4;
const int BUZZER_PIN = 5;

// Batas Kritis (Threshold)
const float AMBANG_SUHU_KRITIS = 38.0;   // °C
const float AMBANG_LEMBAB_RENDAH = 20.0; // %RH

const char* ssid = "Wokwi-GUEST";
const char* password = "";

DHTesp dhtSensor;

unsigned long waktuSebelumnya = 0;
const unsigned long intervalBaca = 2000;

void setup() {
  Serial.begin(115200);
  Serial.println("--- Inisialisasi Node IoT ESP32 (Stand-alone Mode) ---");
  pinMode(LED_NORMAL, OUTPUT);
  pinMode(LED_ALARM, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  dhtSensor.setup(DHT_PIN, DHTesp::DHT22);

  Serial.print("Memeriksa koneksi Wi-Fi: ");
  WiFi.begin(ssid, password);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 10) {
    delay(200);
    Serial.print(".");
    attempts++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n[Wi-Fi Connected!] IP: " + WiFi.localIP().toString());
  } else {
    Serial.println("\n[Mode Offline / Stand-alone] Melanjutkan simulasi tanpa gateway internet.");
  }
}

void loop() {
  unsigned long waktuSekarang = millis();

  if (waktuSekarang - waktuSebelumnya >= intervalBaca) {
    waktuSebelumnya = waktuSekarang;

    TempAndHumidity data = dhtSensor.getTempAndHumidity();

    if (isnan(data.temperature) || isnan(data.humidity)) {
      Serial.println("[Error] Gagal membaca data dari sensor DHT22!");
      return;
    }

    int rssi = (WiFi.status() == WL_CONNECTED) ? WiFi.RSSI() : -65;

    Serial.printf("[Sensor Data] Suhu: %.2f °C | Kelembaban: %.2f %% | RSSI: %d dBm\n",
                  data.temperature, data.humidity, rssi);

    // Evaluasi tiap kondisi pemicu secara terpisah
    bool suhuKritis   = data.temperature > AMBANG_SUHU_KRITIS;
    bool lembabRendah = data.humidity < AMBANG_LEMBAB_RENDAH;

    if (suhuKritis || lembabRendah) {   // kondisi OR
      digitalWrite(LED_ALARM, HIGH);
      digitalWrite(LED_NORMAL, LOW);
      tone(BUZZER_PIN, 1000);

      if (suhuKritis && lembabRendah) {
        Serial.println(">>> ALARM [SUHU & KELEMBABAN]: Suhu > 38 C DAN kelembaban < 20 %! <<<");
      } else if (suhuKritis) {
        Serial.println(">>> ALARM [SUHU TINGGI]: Suhu melebihi 38 C! <<<");
      } else {
        Serial.println(">>> ALARM [UDARA KERING]: Kelembaban di bawah 20 %! <<<");
      }
    } else {
      digitalWrite(LED_ALARM, LOW);
      digitalWrite(LED_NORMAL, HIGH);
      noTone(BUZZER_PIN);
      Serial.println("Status: Lingkungan Normal & Terkendali.");
    }
  }
}
